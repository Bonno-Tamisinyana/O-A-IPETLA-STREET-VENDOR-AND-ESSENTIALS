<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lucky Tuck Shop</title>

<style>
body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f4f4f4;
}

header{
    background:#28a745;
    color:light red;
    text-align:center;
    padding:50px 20px;
}

nav{
    background:#222;
    padding:10px;
    text-align:center;
}

nav a{
    color:brown;
    text-decoration:none;
    margin:15px;
}

section{
    padding:40px 20px;
    max-width:1000px;
    margin:auto;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.product{
    background:white;
    padding:20px;
    border-radius:10px;
    text-align:center;
    box-shadow:0 2px 5px rgba(0,0,0,0.2);
}

.product img{
    width:100%;
    border-radius:10px;
}

.contact{
    background:white;
    padding:25px;
    border-radius:10px;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
}
</style>
</head>

<body>

<header>
    <h1>Lucky Tuck Shop</h1>
    <p>Your Local Store for Everyday Essentials</p>
</header>

<nav>
    #aboutAbout</a>
    #productsProducts</a>
    #contactContact</a>
</nav>

<section id="about">
    <h2>About Us</h2>
    <p>
        Welcome to Lucky Tuck Shop. We sell snacks, drinks,
        groceries, airtime, and other daily household products at affordable prices.
    </p>
</section>

<section id="products">
    <h2>Popular Products</h2>

    <div class="products">

        <div class="product">
            <h3>Soft Drinks</h3>
            <p>Coke, Fanta, Sprite and more.</p>
        </div>

        <div class="product">
            <h3>Chips & Snacks</h3>
            <p>Fresh snacks for school and home.</p>
        </div>

        <div class="product">
            <h3>Bread & Groceries</h3>
            <p>Daily essentials available.</p>
        </div>

        <div class="product">
            <h3>Airtime & Data</h3>
            <p>All major networks supported.</p>
        </div>

    </div>
</section>

<section id="contact">
    <div class="contact">
        <h2>Contact Us</h2>
        <p><strong>Phone:</strong> +267 XXX XXX XX</p>
        <p><strong>Location:</strong> Serowe, Botswana</p>
        <p><strong>WhatsApp Orders:</strong> +267 XXX XXX XX</p>
    </div>
</section>

<footer>
    <p>© 2026 Lucky Tuck Shop. All Rights Reserved.</p>
</footer>

</body>
</html>
